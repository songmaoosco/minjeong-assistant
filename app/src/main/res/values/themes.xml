        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryVariant">@color/orange_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/orange_light</item>
        <item name="colorSecondaryVariant">@color/orange_primary</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="android:colorBackground">@color/chat_bg</item>
        <item name="android:statusBarColor">@color/chat_bg</item>
        <item name="android:navigationBarColor">@color/chat_bg</item>
        <item name="android:windowLightStatusBar">true</item>
